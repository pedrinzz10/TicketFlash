{
  "info": {
    "name": "TicketFlash",
    "description": "API TicketFlash (FastAPI + MongoDB + Redis). Rode o seed e depois '0. Setup' para preencher os ids.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Carregar ids do seed (evento e usuários)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Rode depois do seed. Preenche eventoId (Rock in Concert), usuarioId, outroUsuarioId e rateLimitUsuarioId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const usuarios = pm.response.json();",
                  "pm.test(\"Seed com 20+ usuários\", () => pm.expect(usuarios.length).to.be.at.least(20));",
                  "const porEmail = (email) => usuarios.find(u => u.email === email);",
                  "pm.collectionVariables.set(\"usuarioId\", porEmail(\"ana.souza@email.com\").id);",
                  "pm.collectionVariables.set(\"outroUsuarioId\", porEmail(\"bruno.lima@email.com\").id);",
                  "pm.collectionVariables.set(\"rateLimitUsuarioId\", porEmail(\"carla.dias@email.com\").id);",
                  "console.log(\"usuarioId =\", pm.collectionVariables.get(\"usuarioId\"));",
                  "pm.sendRequest(pm.variables.get(\"baseUrl\") + \"/eventos\", (err, res) => {",
                  "    const rock = res.json().find(e => e.nome.startsWith(\"Rock in Concert\"));",
                  "    pm.collectionVariables.set(\"eventoId\", rock.id);",
                  "    console.log(\"eventoId =\", rock.id);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Rode este request primeiro, sempre depois do seed."
    },
