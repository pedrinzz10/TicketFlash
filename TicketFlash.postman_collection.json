        {
          "name": "UC-07 Rate limit: 10 reservas + a 11ª (429)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"{{rateLimitUsuarioId}}\",\n  \"eventoId\": \"{{eventoId}}\",\n  \"setor\": \"Pista\",\n  \"quantidade\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O pre-request dispara 10 reservas do mesmo usuário (veja no Console); este request é a 11ª e deve dar 429. Espere 60 s para repetir."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get(\"baseUrl\");",
                  "const corpo = {",
                  "    usuarioId: pm.collectionVariables.get(\"rateLimitUsuarioId\"),",
                  "    eventoId: pm.collectionVariables.get(\"eventoId\"),",
                  "    setor: \"Pista\",",
                  "    quantidade: 1",
                  "};",
                  "const codigos = [];",
                  "function disparar(n) {",
                  "    if (n === 0) {",
                  "        console.log(\"Reservas 1 a 10:\", codigos.join(\", \"));",
                  "        return;",
                  "    }",
                  "    pm.sendRequest({",
                  "        url: base + \"/reservas\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: { mode: \"raw\", raw: JSON.stringify(corpo) }",
                  "    }, (err, res) => {",
                  "        codigos.push(res.code);",
                  "        disparar(n - 1);",
                  "    });",
                  "}",
                  "disparar(10);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 429\", () => pm.response.to.have.status(429));"
                ]
              }
            }
          ]
        },
        {
          "name": "UC-07 Outro usuário não é bloqueado (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
